# Copy to .env and fill in. Never commit the real .env file.

# Anthropic API key (required from Phase 5 agent loop onward)
ANTHROPIC_API_KEY=

# CORS origins for the frontend (comma-separated). Include both local and
# the live Railway frontend URL after Phase 9 deploy, e.g.
# FRONTEND_ORIGIN=http://localhost:3000,https://trendly-web-production.up.railway.app
FRONTEND_ORIGIN=http://localhost:3000
